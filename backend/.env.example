DATABASE_URL=postgresql+psycopg://campusgate:campusgate_dev_password@localhost:5433/campusgate
APP_NAME=CampusGate API
APP_VERSION=1.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET_KEY=<replace-with-a-long-random-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Recommended in production. If omitted, the backend derives the pass-signing key from JWT_SECRET_KEY.
CLEARANCE_TOKEN_SECRET=<replace-with-a-separate-random-secret-of-at-least-32-bytes>
# Default pass validity is this many hours after the requested exit time.
CLEARANCE_PASS_VALIDITY_HOURS=24
# Set only temporarily when provisioning the first production admin and gate officer.
# Must be at least 32 bytes; remove it from production after successful provisioning.
BOOTSTRAP_SECRET=
