DATABASE_URL=postgresql+psycopg://campusgate:campusgate_dev_password@localhost:5433/campusgate
APP_NAME=CampusGate API
APP_VERSION=1.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET_KEY=<replace-with-a-long-random-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set only temporarily when provisioning the first production admin and gate officer.
# Must be at least 32 bytes; remove it from production after successful provisioning.
BOOTSTRAP_SECRET=
